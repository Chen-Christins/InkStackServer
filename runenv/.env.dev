# 开发环境变量（runenv/generate.sh dev 使用）
#
# 生效顺序：<进程>_<变量> > 全局 <变量>
# 进程前缀：HUB / USER / ARTICLE / COMMENT / PLATFORM
# 例如：
#   PLATFORM_IO_THREADS=4        只影响 platform 的 io 线程数
#   USER_LOG_LEVEL=debug         只影响 user 的 root 日志级别
#   ARTICLE_MYSQL_DBNAME=art_db  只影响 article 连的库
#   HUB_RPC_TIMEOUT=2000         只影响 hub 的 rpc keepalive 超时
# 线程数在下面「进程 / 协程」段落里，每个进程各有一组。

# ---------------- 路径 ----------------
# 留空表示使用仓库根目录
WORK_PATH=
# 上传/导出等运行数据目录，留空表示 $WORK_PATH/data
DATA_PATH=
# 分词字典与搜索索引，留空表示 $WORK_PATH/dict 和 $WORK_PATH/search_index.dat
SEARCH_DICT_PATH=
SEARCH_INDEX_PATH=

# ---------------- 日志 ----------------
LOG_LEVEL=debug
LOG_LEVEL_SYSTEM=info
LOG_LEVEL_ACCESS=info

# ---------------- 进程 / 协程 ----------------
FIBER_STACK_SIZE=65536
# 默认线程数：没有单独配置的进程用它
IO_THREADS=1
ACCEPT_THREADS=1
# 每个进程的实际线程数（写在这里的优先于上面的默认值）
HUB_IO_THREADS=1
HUB_ACCEPT_THREADS=1
USER_IO_THREADS=1
USER_ACCEPT_THREADS=1
ARTICLE_IO_THREADS=1
ARTICLE_ACCEPT_THREADS=1
COMMENT_IO_THREADS=1
COMMENT_ACCEPT_THREADS=1
PLATFORM_IO_THREADS=2
PLATFORM_ACCEPT_THREADS=1
# 热重载/关机时留给在途请求的时间（毫秒）
DRAIN_TIMEOUT_MS=3000

# ---------------- HTTP ----------------
HTTP_KEEPALIVE=1
HTTP_TIMEOUT=1000
HTTP_NEGOTIATE_H2=1
HTTP_ACCEPT_QPS=1000
HTTP_ACCEPT_BURST=2000
HTTP_MAX_CONN=10000

# ---------------- WebSocket ----------------
WS_KEEPALIVE=1
WS_TIMEOUT=120000

# ---------------- RPC ----------------
# 普通 rpc server（platform 给 GitHub bot 用）与 hub 的监听参数
RPC_KEEPALIVE=1
RPC_TIMEOUT=1000
# hub 转发超时（毫秒）：超过后给调用方回 504
RELAY_TIMEOUT_MS=3000
# 业务服务调用超时（毫秒）
RPC_CALL_TIMEOUT_MS=3000
# 业务服务与 hub 断线重连间隔（毫秒）
RPC_RECONNECT_INTERVAL_MS=5000

# ---------------- 端口 ----------------
HUB_RPC_HOST=127.0.0.1
HUB_RPC_PORT=8092
USER_HTTP_PORT=8101
ARTICLE_HTTP_PORT=8102
COMMENT_HTTP_PORT=8103
PLATFORM_HTTP_PORT=8104
PLATFORM_WS_PORT=8105
PLATFORM_RPC_PORT=8106

# ---------------- MySQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWD=123456
MYSQL_DBNAME=techhaven

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1:6379
REDIS_DBNAME=blog_dev
REDIS_TYPE=fox_redis
REDIS_POOL=1
REDIS_TIMEOUT_MS=100
FOX_REDIS_NUM=1
FOX_REDIS_ADVANCE=0

# ---------------- 业务：AI / 管理员 / 缓存 ----------------
AI_TYPE=glm
AI_MODEL=glm-4.7-flash
AI_API_KEY=
ADMIN_ACCOUNT=admin
ADMIN_PASSWD=admin123456
ADMIN_EMAIL=admin@example.com
CACHE_OBJ_ENABLED=true

# ---------------- 业务：GitHub OAuth ----------------
GITHUB_CLIENT_ID=xxxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=http://localhost:5173/api/v1/user/oauth/github/callback
FRONTEND_BASE=http://localhost:5173

# ---------------- 业务：会话与认证 ----------------
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=604800

# ---------------- 业务：WebAuthn / Passkey ----------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="InkStack Dev"
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_TIMEOUT_MS=60000
WEBAUTHN_USER_VERIFICATION=preferred
WEBAUTHN_ATTESTATION=none
WEBAUTHN_CHALLENGE_TTL=300
WEBAUTHN_USER_HANDLE_SECRET=dev-webauthn-change-me
